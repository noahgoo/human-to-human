# Supabase (Project Settings -> API Keys, and the Connect button for the DB URL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Postgres connection string; only used by the CLI to push the schema and seed
SUPABASE_DB_URL=

OPENROUTER_API_KEY=

# Fit preview (off until explicitly enabled)
FIT_PREVIEW_ENABLED=false
FIT_PREVIEW_SECRET=
# Optional: deep GPT repo review (extra latency/cost; needs GITHUB_TOKEN on serverless)
FIT_PREVIEW_GITHUB_GPT=false
OPENROUTER_GPT_MODEL=openai/gpt-4.1-mini
GITHUB_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: run tests/integration/evaluate-candidate.live.test.ts against your export folder
# LINKEDIN_EXPORT_DIR=/path/to/Basic_LinkedInDataExport_.../

# Shared password for the seeded demo accounts; also used by scripts/gen-seed.mjs
DEMO_PASSWORD=
